{
  "name": "@live2pet/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first Live2Pet desktop shell",
  "main": "main.cjs",
  "scripts": {
    "prepare:mapper": "node scripts/stage-mapper-assets.cjs",
    "benchmark:capture": "node scripts/benchmark-capture-transport.cjs",
    "package:mac": "node scripts/stage-mapper-assets.cjs && node scripts/package-macos.cjs",
    "smoke:mac": "node scripts/smoke-packaged-app.cjs",
    "start": "electron .",
    "typecheck": "node --check main.cjs preload.cjs renderer-host.cjs renderer-preview-service.cjs forge.config.cjs scripts/*.cjs"
  },
  "dependencies": {
    "@live2pet/app-host": "workspace:*",
    "@live2pet/installation": "workspace:*",
    "@live2pet/mapper-session": "workspace:*",
    "@live2pet/package-build": "workspace:*",
    "@live2pet/renderer": "workspace:*",
    "@live2pet/runtime": "workspace:*",
    "@live2pet/skill-manager": "workspace:*",
    "@live2pet/source-inspector": "workspace:*"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.0.0"
  },
  "config": {
    "forge": "forge.config.cjs"
  }
}
